# Nach .env kopieren und anpassen:  cp .env.beispiel .env

# Adresse, unter der die Anwendung erreichbar ist. Die Domain muss per DNS (A-Record)
# auf die IP des VPS zeigen; Caddy holt dann automatisch ein HTTPS-Zertifikat.
DOMAIN=melder.example.de
# Nur zum Testen ohne Domain (unverschluesselt ueber http://<IP-des-VPS>):
# DOMAIN=:80

# Anmeldung
APP_BENUTZER=planer
APP_PASSWORT=

# Groesste IFC-Datei in MB und Aufbewahrung der Auftraege in Tagen
MAX_UPLOAD_MB=500
AUFBEWAHRUNG_TAGE=14
