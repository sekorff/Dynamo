    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Datendosen-Platzierung: laedt die Skripte aus dem Ordner (IN[0]).\n# IN[0] Ordner mit datendosen_core.py / datendosen_revit.py\n# IN[1] Pfad zur config.json (leer = config.json im Ordner)\n# IN[2] True = Familien platzieren, False = nur berechnen (Probelauf)\nimport sys\nordner = str(IN[0])\nif ordner not in sys.path:\n    sys.path.insert(0, ordner)\nimport datendosen_core\nimport datendosen_revit\ntry:\n    from importlib import reload\nexcept ImportError:\n    pass\nreload(datendosen_core)\nreload(datendosen_revit)\nOUT = datendosen_revit.ausfuehren(ordner, IN[1] if len(IN) > 1 else None, bool(IN[2]) if len(IN) > 2 else False)\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "9605c5935513453abe75650f72fffbe2",
